  "components" : {
    "schemas" : {
      "ApiErrorResponseDTO" : {
        "type" : "object",
        "description" : "Respuesta de error RFC 9457, con código funcional y errores por campo.",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri",
            "description" : "Referencia URI al tipo de problema.",
            "example" : "about:blank"
          },
          "title" : {
            "type" : "string",
            "description" : "Resumen del problema.",
            "example" : "Solicitud incorrecta"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Estado HTTP de la respuesta.",
            "example" : 400,
            "maximum" : 599,
            "minimum" : 400
          },
          "detail" : {
            "type" : "string",
            "description" : "Explicación de lo ocurrido en esta solicitud.",
            "example" : "Revisa los campos indicados."
          },
          "instance" : {
            "type" : "string",
            "format" : "uri-reference",
            "description" : "Referencia URI opcional que identifica esta ocurrencia del problema.",
            "example" : "urn:uuid:7d667530-867b-4c78-a458-0904fb82d574"
          },
          "errorCode" : {
            "type" : "string",
            "description" : "Código funcional estable; el frontend no debe comparar los mensajes.",
            "example" : "INVALID_REQUEST"
          },
          "fieldErrors" : {
            "type" : "array",
            "description" : "Errores por campo. Es una lista vacía cuando el error no corresponde a campos específicos.",
            "items" : {
              "$ref" : "#/components/schemas/FieldValidationErrorResponseDTO"
            }
          }
        },
        "required" : [ "detail", "errorCode", "fieldErrors", "status", "title", "type" ]
      },
      "FieldValidationErrorResponseDTO" : {
        "type" : "object",
        "description" : "Error asociado a un campo de la solicitud. Nunca contiene el valor recibido.",
        "properties" : {
          "field" : {
            "type" : "string",
            "description" : "Nombre del campo en el contrato JSON.",
            "example" : "email"
          },
          "code" : {
            "type" : "string",
            "description" : "Código estable que identifica el error del campo.",
            "example" : "TYPE_MISMATCH"
          },
          "message" : {
            "type" : "string",
            "description" : "Explicación legible para la persona usuaria.",
            "example" : "Debe enviarse como texto."
          }
        },
        "required" : [ "code", "field", "message" ]
      },
      "UserLoginRequestDTO" : {
        "type" : "object",
        "description" : "Credentials used to sign in to GrownupsVet.",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "description" : "Email address associated with the account.",
            "example" : "persona@example.com",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "format" : "password",
            "description" : "Account password. Accepted only in requests; never returned in responses.",
            "maxLength" : 128,
            "minLength" : 1,
            "writeOnly" : true
          }
        },
        "required" : [ "email", "password" ]
      },
      "AuthenticatedUserResponseDTO" : {
        "type" : "object",
        "description" : "Public account identity returned after successful authentication.",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string",
            "format" : "email"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "OWNER", "VETERINARIAN", "ADMINISTRATOR" ]
          },
          "permissions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        },
        "required" : [ "email", "id", "permissions", "role" ]
      },
      "UserLoginResponseDTO" : {
        "type" : "object",
        "description" : "Bearer session created after valid credentials. No refresh token is issued.",
        "properties" : {
          "accessToken" : {
            "type" : "string",
            "description" : "RS256-signed JWT access token.",
            "readOnly" : true
          },
          "tokenType" : {
            "type" : "string",
            "enum" : [ "Bearer" ],
            "example" : "Bearer"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Token lifetime in seconds.",
            "example" : 86400
          },
          "user" : {
            "$ref" : "#/components/schemas/AuthenticatedUserResponseDTO"
          }
        },
        "required" : [ "accessToken", "expiresIn", "tokenType", "user" ]
      },
      "UserSignupRequestDTO" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "Datos para crear una cuenta de propietario. No admite propiedades adicionales.",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "description" : "Correo de acceso. Se guarda en minúsculas; debe tener formato de correo válido.",
            "example" : "persona@example.com",
            "maxLength" : 254,
            "minLength" : 3
          },
          "fullName" : {
            "type" : "string",
            "description" : "Nombre y apellido, al menos dos componentes. Admite letras internacionales, apóstrofos, guiones y puntos; máximo 150 caracteres incluyendo espacios. Se retiran espacios exteriores al guardar.",
            "example" : "María del Carmen Gómez",
            "maxLength" : 150,
            "minLength" : 3
          },
          "dateOfBirth" : {
            "type" : "string",
            "format" : "date",
            "description" : "Fecha no futura en formato YYYY-MM-DD. Edad de 0 a 130 años cumplidos, calculada con la fecha de America/Bogota.",
            "example" : "1955-05-20"
          },
          "phoneNumber" : {
            "type" : "string",
            "description" : "Número internacional E.164 sin espacios ni extensiones. Se valida con metadatos internacionales; no acredita titularidad ni disponibilidad de WhatsApp.",
            "example" : "+573001234567",
            "maxLength" : 16,
            "minLength" : 3,
            "pattern" : "^\\+[1-9][0-9]{1,14}$"
          },
          "password" : {
            "type" : "string",
            "format" : "password",
            "description" : "15–128 puntos de código Unicode. Admite espacios, sin composición obligatoria. No se transforma ni se devuelve. Se rechazan contraseñas comunes.",
            "maxLength" : 128,
            "minLength" : 15,
            "writeOnly" : true
          }
        },
        "required" : [ "dateOfBirth", "email", "fullName", "password", "phoneNumber" ]
      },
      "UserSignupResponseDTO" : {
        "type" : "object",
        "description" : "Cuenta de propietario creada. La interfaz conduce al login; esta respuesta no contiene sesión ni contraseña.",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "7d667530-867b-4c78-a458-0904fb82d574"
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "description" : "Correo normalizado de la cuenta creada.",
            "example" : "persona@example.com",
            "maxLength" : 254
          }
        },
        "required" : [ "email", "id" ]
      },
      "UpdateOwnerProfileRequestDTO" : {
        "type" : "object",
        "additionalProperties" : false,
        "description" : "Único cambio de perfil permitido al propietario. No admite propiedades adicionales.",
        "properties" : {
          "phoneNumber" : {
            "type" : "string",
            "example" : "+573001234567",
            "maxLength" : 16,
            "minLength" : 3,
            "pattern" : "^\\+[1-9][0-9]{1,14}$"
          }
        },
        "required" : [ "phoneNumber" ]
      },
      "OwnerProfileResponseDTO" : {
        "type" : "object",
        "description" : "Cuenta y perfil del propietario autenticado; nunca contiene credenciales.",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254
          },
          "role" : {
            "type" : "string",
            "enum" : [ "OWNER", "VETERINARIAN", "ADMINISTRATOR" ]
          },
          "active" : {
            "type" : "boolean"
          },
          "fullName" : {
            "type" : "string",
            "maxLength" : 150
          },
          "dateOfBirth" : {
            "type" : "string",
            "format" : "date"
          },
          "phoneNumber" : {
            "type" : "string",
            "pattern" : "^\\+[1-9][0-9]{1,14}$"
          },
          "profilePhotoUrl" : {
            "type" : [ "string", "null" ],
            "description" : "Ruta API relativa de la foto protegida, o null cuando no existe.",
            "example" : "/api/v1/users/me/profile/photo"
          }
        },
        "required" : [ "active", "dateOfBirth", "email", "fullName", "id", "phoneNumber", "role" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
